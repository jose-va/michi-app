{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.michisushigranada.es"
        }
      ],
      "destination": "https://michisushigranada.es/$1",
      "permanent": true
    }
  ]
}